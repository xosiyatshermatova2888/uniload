# Lokal ishlab chiqish uchun namunaviy sozlamalar. Nusxa: cp .env.example .env
UNILOAD_ENV=dev
UNILOAD_DATABASE_URL=postgresql+psycopg://uniload_app:uniload_app@localhost:5433/uniload
UNILOAD_MIGRATION_DATABASE_URL=postgresql+psycopg://uniload:uniload@localhost:5433/uniload
UNILOAD_REDIS_URL=redis://localhost:6380/0
# Production’da kamida 32 belgili tasodifiy qiymat:  python -c "import secrets; print(secrets.token_urlsafe(48))"
UNILOAD_JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
UNILOAD_COOKIE_SECURE=false
UNILOAD_CORS_ORIGINS=["http://localhost:3000"]

# Demo seed paroli (faqat dev/test). Barcha demo foydalanuvchilar uchun bir xil.
UNILOAD_SEED_PASSWORD=Demo12345!
